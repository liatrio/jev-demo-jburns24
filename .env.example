# Vercel AI Gateway key. One key reaches all three models:
#   typesafe-ai/jev, anthropic/claude-sonnet-5, openai/gpt-5.6-luna
API_KEY=

# replay  - serve every request from tests/cassettes; fail loudly on a miss (default for tests)
# record  - use cassettes when present, otherwise call the gateway and save the response (default for CLI)
# live    - always call the gateway, never read or write cassettes
JEV_DEMO_MODE=record

# Optional overrides
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
# JEV_DEMO_CASSETTES=tests/cassettes
# JEV_DEMO_RESULTS=results
